# Proxy Rotation & Refresher Configuration
PROXY_ENABLED=true
PROXY_SOURCE_ENABLED=true
PROXY_REFRESH_INTERVAL_SECONDS=120
PROXY_SOURCE_URL=https://free-proxy-list.net/
PROXY_RAW_FILE=data/proxylist.txt
PROXY_LIST_FILE=data/low_latency_proxies.txt
PROXY_TIMEOUT=2
PROXY_MAX_LATENCY_SECONDS=1.5
PROXY_MAX_RETRIES=3
PROXY_FAILURE_THRESHOLD=2
PROXY_COOLDOWN_SECONDS=180
PROXY_CHECK_CONCURRENCY=50
PROXY_TEST_URL=https://api.ipify.org?format=json
PROXY_FALLBACK_DIRECT=false

# Optional SERP / Search API Configuration
API_KEY_SERP=your_serp_api_key_here
